# Copy this file to .env and fill in real values before deploying.
PORT=3000
# If your password contains a '#', wrap it in double quotes — dotenv treats
# an unquoted '#' as starting a comment and silently truncates everything
# after it (e.g. ADMIN_PASSWORD=abc#123 becomes just "abc"). Quoting is safe
# either way, so just always do it: ADMIN_PASSWORD="your-actual-password"
ADMIN_PASSWORD="change-me-to-a-strong-password"
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: only needed if you are running Node's HTTPS server directly instead of behind a reverse proxy
# SSL_CERT_PATH=
# SSL_KEY_PATH=
NODE_ENV=production
# Only set this to true if you deploy behind a reverse proxy (Caddy/nginx/etc,
# see the HTTPS section in README.md, option a). Leave it unset/false if you
# use option (b) direct HTTPS via SSL_CERT_PATH/SSL_KEY_PATH, or plain local
# testing — setting it without an actual proxy in front lets anyone spoof
# their IP and bypass rate limiting.
# TRUST_PROXY=true
